{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "oxc": {
    "experimentalSortImports": { "newlinesBetween": true },
    "lineWidth": 80,
    "proseWrap": "always",
    "sortPackageJson": false,
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      // rustfmt finds rustfmt.toml from the working directory.
      { "command": "rustfmt --edition 2024", "exts": ["rs"] },
    ],
  },
  "ktfmt": {
    "style": "google",
    "lineWidth": 100,
  },
  "excludes": [
    // Generated by `cargo xtask support`.
    "docs/style-support.md",
    // Test expectations and demo data written by tools.
    "crates/*/tests/data/**",
    "crates/orb-crs/tests/proj_reference.json",
    "web/demo/data/**",
    // The demos' hand-written scene catalogue.
    "!web/demo/data/scenes.json",
    "web/pnpm-lock.yaml",
  ],
  "plugins": [
    "npm:@dprint/oxc@0.49.1",
    "npm:@dprint/exec@0.9.0/plugin.json@d4f708dc00798b51013ca4e7c26a86656bfb31e7255cdcde28a487f86813e34d",
    "npm:@dprint/ruff@0.12.1",
    "https://plugins.dprint.dev/sargunv/ktfmt-0.65.0.json@d355d4440dda00c0e315b5c39669f417bcfa76b64b68591fa1818f7a1f6b1005",
  ],
}
