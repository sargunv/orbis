<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- No Java or Kotlin of its own: orb-android's liborbis.so is the
         app, and the only code beside it is rustls-platform-verifier's
         Kotlin half, which its HTTPS calls. -->
    <application android:label="Orbis" android:allowBackup="false">
        <!-- Shown over the keyguard so it runs on locked test devices; one
             instance, since android-activity runs one activity a process. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="orbis" />
        </activity>
        <!-- The name scripts start: dev.orbis.demo/.MainActivity.
             NativeActivity reads the library's name from the component it
             was started as. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity="android.app.NativeActivity"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="orbis" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
