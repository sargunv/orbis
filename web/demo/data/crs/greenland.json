{
 "style": {
  "version": 8,
  "name": "Greenland, Web Mercator over EPSG:3413",
  "center": [
   -42,
   72
  ],
  "zoom": 3.2,
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
   "openmaptiles": {
    "type": "vector",
    "url": "https://tiles.openfreemap.org/planet",
    "attribution": "<a href=\"https://openfreemap.org\">OpenFreeMap</a> <a href=\"https://www.openmaptiles.org/\">© OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
   },
   "velocity": {
    "type": "raster",
    "tileSize": 512,
    "maxzoom": 4,
    "attribution": "<a href=\"https://earthdata.nasa.gov/gibs\">NASA EOSDIS GIBS</a>",
    "tiles": [
     "https://gibs.earthdata.nasa.gov/wmts/epsg3413/best/MEaSUREs_Ice_Velocity_Greenland/default/2008-12-01/500m/{tileMatrix}/{tileRow}/{tileCol}.png"
    ]
   }
  },
  "layers": [
   {
    "id": "background",
    "type": "background",
    "paint": {
     "background-color": "#f2efe9"
    }
   },
   {
    "id": "glacier",
    "type": "fill",
    "source": "openmaptiles",
    "source-layer": "landcover",
    "filter": [
     "==",
     [
      "get",
      "subclass"
     ],
     "glacier"
    ],
    "paint": {
     "fill-color": "#ffffff"
    }
   },
   {
    "id": "water",
    "type": "fill",
    "source": "openmaptiles",
    "source-layer": "water",
    "paint": {
     "fill-color": "#a9c9e6"
    }
   },
   {
    "id": "velocity",
    "type": "raster",
    "source": "velocity",
    "paint": {
     "raster-opacity": 0.9
    }
   },
   {
    "id": "boundary",
    "type": "line",
    "source": "openmaptiles",
    "source-layer": "boundary",
    "filter": [
     "<=",
     [
      "get",
      "admin_level"
     ],
     4
    ],
    "paint": {
     "line-color": "#8d8195",
     "line-width": [
      "interpolate",
      [
       "linear"
      ],
      [
       "zoom"
      ],
      2,
      0.6,
      8,
      1.5
     ],
     "line-dasharray": [
      3,
      2
     ]
    }
   },
   {
    "id": "roads",
    "type": "line",
    "source": "openmaptiles",
    "source-layer": "transportation",
    "minzoom": 6,
    "paint": {
     "line-color": "#c0a080",
     "line-width": 1
    }
   },
   {
    "id": "water-name",
    "type": "symbol",
    "source": "openmaptiles",
    "source-layer": "water_name",
    "layout": {
     "text-field": [
      "coalesce",
      [
       "get",
       "name:en"
      ],
      [
       "get",
       "name"
      ]
     ],
     "text-font": [
      "Noto Sans Italic"
     ],
     "text-size": 12,
     "text-max-width": 6
    },
    "paint": {
     "text-color": "#3b6c96",
     "text-halo-color": "rgba(255,255,255,0.7)",
     "text-halo-width": 1
    }
   },
   {
    "id": "place",
    "type": "symbol",
    "source": "openmaptiles",
    "source-layer": "place",
    "filter": [
     "in",
     [
      "get",
      "class"
     ],
     [
      "literal",
      [
       "country",
       "state",
       "city",
       "town"
      ]
     ]
    ],
    "layout": {
     "text-field": [
      "coalesce",
      [
       "get",
       "name:en"
      ],
      [
       "get",
       "name"
      ]
     ],
     "text-font": [
      "Noto Sans Regular"
     ],
     "text-size": [
      "match",
      [
       "get",
       "class"
      ],
      "country",
      14,
      "state",
      12,
      11
     ]
    },
    "paint": {
     "text-color": "#333",
     "text-halo-color": "#fff",
     "text-halo-width": 1.2
    }
   }
  ]
 },
