{
  "style": "alps.json",
  "lights": [
    {"id": "sky", "type": "ambient", "properties": {"color": "#dfe9ff", "intensity": 0.45}},
    {"id": "sun", "type": "sun", "properties": {"time": "2024-07-15T07:30:00Z", "color": "#fff1dc", "intensity": 0.9}}
  ],
  "layers": {"buildings": {"emissive-strength": 0.1}},
  "layers+": [
    {
      "id": "contours",
      "type": "contour",
      "source": "hillshade",
      "after": "hillshade",
      "paint": {
        "contour-interval": ["step", ["zoom"], 200, 11, 100, 12.5, 50, 14, 20, 15.5, 10],
        "contour-major": 5,
        "contour-color": "#7a5636",
        "contour-opacity": 0.7,
        "contour-width": 0.8,
        "contour-major-width": 1.6
      }
    },
    {
      "id": "trails",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "after": "roads-minor",
      "minzoom": 12,
      "filter": ["==", ["get", "class"], "path"],
      "layout": {"line-join": "round"},
      "paint": {
        "line-color": "#c8322a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 16, 2.5],
        "line-dasharray": [2, 1.5]
      }
    }
  ]
}
