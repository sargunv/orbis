{
  "version": 8,
  "name": "Watercolor",
  "metadata": {
    "description": "Orbis's render targets (the dev.sargunv.orbis:targets preview) after Stamen Watercolor and Wet Dog Weather's sketch of it in MapLibre: land, parks, water and roads painted into one target in colours told apart, a mask selected from it for each, blurred, roughened by noise fixed to the map and cut, then filled with darker edges where the paint pools, over paper with a grain of its own."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "center": [
    -0.1,
    51.507
  ],
  "zoom": 13,
  "dev.sargunv.orbis:targets": [
    {
      "id": "paint"
    },
    {
      "id": "land"
    },
    {
      "id": "water"
    },
    {
      "id": "green"
    },
    {
      "id": "land-edge"
    },
    {
      "id": "water-edge"
    },
    {
      "id": "green-edge"
    },
    {
