{
 "style": {
  "version": 8,
  "projection": {
   "type": "globe"
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
   "ne2_shaded": {
    "type": "raster",
    "tiles": [
     "https://tiles.openfreemap.org/natural_earth/ne2sr/{z}/{x}/{y}.png"
    ],
    "tileSize": 256,
    "maxzoom": 6,
    "attribution": "<a href=\"https://openfreemap.org\">OpenFreeMap</a> Natural Earth"
   },
   "openmaptiles": {
    "type": "vector",
    "url": "https://tiles.openfreemap.org/planet"
   },
   "black-marble": {
    "type": "raster",
    "tileSize": 256,
    "maxzoom": 8,
    "tiles": [
     "https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/VIIRS_Black_Marble/default/2016-01-01/GoogleMapsCompatible_Level8/{z}/{y}/{x}.png"
    ],
    "attribution": "Night lights: <a href=\"https://earthobservatory.nasa.gov/features/NightLights\">NASA Black Marble</a> via <a href=\"https://earthdata.nasa.gov/gibs\">NASA GIBS</a>"
   }
  },
  "layers": [
   {
    "id": "background",
    "type": "background",
    "paint": {
     "background-color": "#e6dfcf"
    }
   },
   {
    "id": "natural_earth",
    "type": "raster",
    "source": "ne2_shaded",
    "maxzoom": 8,
    "paint": {
     "raster-opacity": [
      "interpolate",
      [
       "linear"
      ],
      [
       "zoom"
      ],
      0,
      0.9,
      7,
      0.3
     ]
    }
   },
   {
    "id": "water",
    "type": "fill",
    "source": "openmaptiles",
    "source-layer": "water",
    "filter": [
     "!=",
     [
      "get",
      "brunnel"
     ],
     "tunnel"
    ],
    "paint": {
     "fill-color": "rgb(104,146,206)"
    }
   },
   {
    "id": "boundary_2",
    "type": "line",
    "source": "openmaptiles",
    "source-layer": "boundary",
    "filter": [
     "all",
     [
      "==",
      [
       "get",
       "admin_level"
      ],
      2
     ],
     [
      "!=",
      [
       "get",
       "maritime"
      ],
      1
     ]
    ],
    "layout": {
     "line-cap": "round",
     "line-join": "round"
    },
    "paint": {
     "line-color": "hsl(30,10%,45%)",
     "line-opacity": 0.6,
     "line-width": [
      "interpolate",
      [
       "linear"
      ],
      [
       "zoom"
      ],
      1,
      0.6,
      5,
      1.2
     ]
    }
   },
   {
    "id": "black-marble",
    "type": "raster",
    "source": "black-marble",
    "paint": {
     "raster-resampling": "linear"
    }
   },
   {
    "id": "label_country_1",
    "type": "symbol",
    "source": "openmaptiles",
    "source-layer": "place",
    "maxzoom": 9,
    "filter": [
     "all",
     [
      "==",
      [
       "get",
       "class"
      ],
      "country"
     ],
     [
      "==",
      [
       "get",
       "rank"
      ],
      1
     ]
    ],
    "layout": {
     "text-field": [
      "coalesce",
      [
       "get",
       "name:latin"
      ],
      [
       "get",
       "name_en"
