#!/usr/bin/env bash
# Prints the adb serial of the Android device a script drives.
#
#   scripts/android-serial [--physical]
#
# ANDROID_SERIAL wins when it is set. Otherwise devices-cli gives this worktree
# its own emulator at ORB_ANDROID_EMULATOR_API, booted on demand, which keeps
# running until `devices-cli release`. Functional Android checks run there,
# though its Vulkan (gfxstream) currently loses the device while the reference
# app's map loads, so checks that draw need a phone until that is fixed.
# The image is the Google APIs variant of the AOSP release: the bench and
# measure scripts drive Chrome, which the plain AOSP image lacks.
#
# --physical is for measuring a real phone's performance, which is rarely
# needed: it gives the connected phone assigned to this worktree, at whatever
# API level it runs, and fails rather than fall back to the emulator. The
# caller first assigns a phone with `devices-cli assign <serial>` and runs
# `devices-cli release` right after the measurement, which serializes the
# phones across agents.
set -euo pipefail

usage="usage: scripts/android-serial [--physical]"
physical=
case $# in
  0) ;;
  1)
    if [[ $1 != --physical ]]; then
      echo "$usage" >&2
      exit 2
    fi
    physical=1
    ;;
  *)
    echo "$usage" >&2
    exit 2
    ;;
esac
api=${ORB_ANDROID_EMULATOR_API:?ORB_ANDROID_EMULATOR_API must name the Android API level (mise sets it)}

if [[ -n "${ANDROID_SERIAL:-}" ]]; then
  serial=$ANDROID_SERIAL
elif [[ -n "$physical" ]]; then
  # The phones assigned to this worktree; the first connected one, asked for at
  # its own API level, which devices-cli then hands out before any emulator.
  owner=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
  serial=
  for pinned in $(devices-cli ls --json | node -e '
    const { pins = [] } = JSON.parse(require("fs").readFileSync(0, "utf8"));
    for (const p of pins) if (p.kind === "android" && p.owner === process.argv[1]) console.log(p.id);
  ' "$owner"); do
    if [[ $(adb -s "$pinned" get-state 2>/dev/null) == device ]]; then
      level=$(adb -s "$pinned" shell getprop ro.build.version.sdk | tr -d '\r')
      serial=$(devices-cli get android --api "$level" --wait 0)
      break
    fi
  done
  if [[ -z "$serial" ]]; then
    echo "No phone assigned to this worktree is connected." >&2
    echo "Connect one, then: devices-cli assign <serial>; measure; devices-cli release." >&2
    exit 1
  fi
else
  serial=$(devices-cli get android --api "$api" --variant google_apis)
fi

if [[ -n "$physical" ]]; then
  # devices-cli hands out an assigned phone when it runs the API level and ABI
  # asked for, and an emulator otherwise, so a measurement checks what it got.
  characteristics=$(adb -s "$serial" shell getprop ro.build.characteristics 2>/dev/null | tr -d '\r') || true
  kernel_qemu=$(adb -s "$serial" shell getprop ro.kernel.qemu 2>/dev/null | tr -d '\r') || true
  if [[ "$characteristics" == *emulator* || "$kernel_qemu" == 1 ]]; then
    echo "Android device $serial is an emulator, and this needs a physical phone." >&2
    echo "Connect one, then: devices-cli assign <serial>; measure; devices-cli release." >&2
    exit 1
  fi
fi

printf '%s\n' "$serial"
